<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
  <title>Telegram 75-Ball Bingo</title>
  <script src="https://telegram.org/js/telegram-web-app.js"></script>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <div id="app">
    <!-- Header -->
    <header class="app-header">
      <div class="user-profile">
        <img id="user-avatar" src="https://via.placeholder.com/40" alt="Avatar">
        <div class="user-info">
          <span id="user-name">Player</span>
          <span id="user-balance">Balance: 5,000</span>
        </div>
      </div>
      <div class="game-status">
        <span class="badge" id="called-count">Balls: 0 / 20</span>
      </div>
    </header>

    <!-- Display Callouts -->
    <section class="ball-caller-section">
      <div class="last-ball-container">
        <div class="ball-callout" id="current-ball">--</div>
        <div class="ball-label" id="current-letter">WAITING FOR GAME</div>
      </div>
      <div class="recent-balls" id="recent-balls-list"></div>
    </section>

    <!-- Ticket Purchase Panel -->
    <section class="purchase-panel" id="purchase-panel">
      <h2>Select Your Tickets</h2>
      <p class="subtitle">Price: <strong>500</strong> per ticket (Max 4 tickets)</p>
      
      <div class="ticket-selector">
        <button class="selector-btn" onclick="changeTicketCount(-1)">-</button>
        <span id="ticket-count-display">1</span>
        <button class="selector-btn" onclick="changeTicketCount(1)">+</button>
      </div>
      
      <div class="cost-summary">
        Total Cost: <span id="total-cost-display">500</span>
      </div>

      <button class="primary-btn" id="buy-btn" onclick="confirmPurchase()">Buy Tickets & Play</button>
    </section>

    <!-- Playing Area -->
    <section class="tickets-container hidden" id="tickets-container">
      <!-- Tickets dynamically generated in app.js -->
    </section>

    <!-- Floating Action Button -->
    <div class="action-bar hidden" id="action-bar">
      <button class="bingo-claim-btn" id="bingo-btn" onclick="claimBingo()">BINGO!</button>
    </div>
  </div>

  <canvas id="confetti-canvas"></canvas>
  <script src="app.js"></script>
</body>
</html>
